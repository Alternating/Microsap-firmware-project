+/**
+ * @brief The argument for a block read or write command.
+ *
+ * SDHC and SDXC Cards (CCS=1) take the block number; SDSC Cards (CCS=0, up to
+ * and including 2 GB) take a byte address. CMD16 has set their block to 512.
+ */
+static inline uint32_t block_arg(sd_card_t *sd_card_p, uint32_t block) {
+    return SDCARD_V2HC == sd_card_p->state.card_type ? block : block * sd_block_size;
+}
